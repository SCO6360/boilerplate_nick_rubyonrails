<section class="mx-auto max-w-2xl text-center">
  <h1 class="text-5xl font-bold tracking-tight text-gray-900">Rails Boilerplate</h1>
  <p class="mt-6 text-lg text-gray-600">
    Rails 8, Tailwind CSS, built-in authentication, Solid Queue/Cache/Cable, Kamal and CI. Clone it, rename it, build your app.
  </p>
  <div class="mt-10">
    <% if authenticated? %>
      <%= link_to "Go to dashboard", dashboard_path, class: "rounded-md bg-blue-600 px-5 py-3 font-medium text-white hover:bg-blue-500" %>
    <% else %>
      <%= link_to "Sign in", new_session_path, class: "rounded-md bg-blue-600 px-5 py-3 font-medium text-white hover:bg-blue-500" %>
    <% end %>
  </div>
</section>
